  <!-- ============ TESTO: la poesia, strofa per strofa e verso per verso ============ -->
  <text>
    <body>
      <lg type="poem">
        <head>Pianto antico</head>

        <lg type="stanza" n="1">
          <l n="1">L'albero a cui tendevi</l>
          <l n="2">la pargoletta mano,</l>
          <l n="3"><seg xml:id="passo-melograno"><rs type="oggetto" ref="#OGG-0008" ana="#motivo">il verde melograno</rs></seg></l>
          <l n="4">da' bei vermigli fior,</l>
        </lg>

        <lg type="stanza" n="2">
          <l n="5">nel muto orto solingo</l>
          <l n="6">rinverdì tutto or ora</l>
          <l n="7">e <date>giugno</date> lo ristora</l>
          <l n="8">di luce e di calor.</l>
        </lg>

        <lg type="stanza" n="3">
          <l n="9">Tu fior de la mia pianta</l>
          <l n="10">percossa e inaridita,</l>
          <l n="11">tu de l'inutil vita</l>
          <l n="12">estremo unico fior,</l>
        </lg>

        <lg type="stanza" n="4">
          <l n="13">sei ne la terra fredda,</l>
          <l n="14">sei ne la terra negra;</l>
          <l n="15">né il sol più ti rallegra</l>
          <l n="16">né ti risveglia amor.</l>
        </lg>
      </lg>
    </body>
  </text>
